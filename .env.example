# ── Supabase ─────────────────────────────────────────────────────────
# Project URL + anon key: Supabase Dashboard → Project Settings → API
# (or `supabase start` output for local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── OpenAI ───────────────────────────────────────────────────────────
# The single server-side image key — the operator pays for inference.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional; defaults to gpt-image-1
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── App ──────────────────────────────────────────────────────────────
# Absolute URL of this deployment, used for auth email redirects.
APP_URL=http://localhost:3000
