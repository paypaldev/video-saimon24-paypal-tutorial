# ── Supabase ─────────────────────────────────────────────────────────
# Project URL + anon key: Supabase Dashboard → Project Settings → API
# (or `supabase start` output for local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── OpenAI ───────────────────────────────────────────────────────────
# The single server-side image key — the operator pays for inference.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional; defaults to gpt-image-1
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── App ──────────────────────────────────────────────────────────────
# Absolute URL of this deployment, used for auth redirects.
APP_URL=http://localhost:3000

# ── PayPal subscriptions (optional) ──────────────────────────────────
# Leave every variable below empty to run without billing: the Pro plan
# shows as "Coming soon" and no checkout is rendered. Fill in all five to
# turn on the PayPal checkout. Setup walkthrough: README → "PayPal setup".

# sandbox | live — picks the PayPal API base URL. Defaults to sandbox.
PAYPAL_ENV=sandbox

# Dashboard → Apps & Credentials → your app. The client id is public (it is
# part of the SDK script URL); the secret is server-only.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Subscriptions → the monthly plan you created for Pro (starts with "P-").
PAYPAL_PLAN_ID_PRO=

# Webhooks → your webhook → the id shown next to it (starts with "WH-").
# Used to signature-verify every incoming webhook.
PAYPAL_WEBHOOK_ID=

# Supabase Dashboard → Project Settings → API → service_role key.
# Server-only: the PayPal webhook/confirm route writes plan columns that RLS
# blocks, and /api/generate refunds a credit when the provider fails.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
